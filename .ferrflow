{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "recoverMissedReleases": true,
    "skipCi": true
  },
  "package": [
    { "name": "foundation", "path": "packages/foundation", "changelog": "packages/foundation/CHANGELOG.md", "versionedFiles": [{ "path": "packages/foundation/package.json", "format": "json" }] },
    { "name": "ui", "path": "packages/ui", "changelog": "packages/ui/CHANGELOG.md", "versionedFiles": [{ "path": "packages/ui/package.json", "format": "json" }] },
    { "name": "primitives", "path": "packages/primitives", "changelog": "packages/primitives/CHANGELOG.md", "versionedFiles": [{ "path": "packages/primitives/package.json", "format": "json" }] },
    { "name": "react", "path": "packages/react", "changelog": "packages/react/CHANGELOG.md", "versionedFiles": [{ "path": "packages/react/package.json", "format": "json" }] },
    { "name": "astro", "path": "packages/astro", "changelog": "packages/astro/CHANGELOG.md", "versionedFiles": [{ "path": "packages/astro/package.json", "format": "json" }] },
    { "name": "auth", "path": "packages/auth", "changelog": "packages/auth/CHANGELOG.md", "versionedFiles": [{ "path": "packages/auth/package.json", "format": "json" }] }
  ]
}

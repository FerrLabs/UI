{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "releaseCommitBody": "full",
    "recoverMissedReleases": true,
    "skipCi": true
  },
  "package": [
    { "name": "foundation", "path": "packages/foundation", "changelog": "packages/foundation/CHANGELOG.md", "versionedFiles": [{ "path": "packages/foundation/package.json", "format": "json" }] },
    { "name": "ui-ng", "path": "packages/ui-ng", "changelog": "packages/ui-ng/CHANGELOG.md", "versionedFiles": [{ "path": "packages/ui-ng/package.json", "format": "json" }] }
  ]
}

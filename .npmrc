# The GitHub Packages token is deliberately not set here: pnpm 11+ ignores
# environment-variable expansion in a committed project .npmrc. Set it once at
# user level instead:  pnpm config set "//npm.pkg.github.com/:_authToken" <token>
# CI gets it from actions/setup-node; image builds set it in the Dockerfile.
@ferrlabs:registry=https://npm.pkg.github.com
always-auth=true

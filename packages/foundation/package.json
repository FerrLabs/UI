{
  "bugs": {
    "url": "https://github.com/FerrLabs/UI/issues"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.0.0",
    "@fontsource/fraunces": "^5.0.0"
  },
  "description": "Framework-agnostic FerrLabs design foundation: SVG icons, base CSS + fonts, Tailwind preset tokens. Consumed by both @ferrlabs/ui (React) and @ferrlabs/ui-astro.",
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons": {
      "default": "./dist/icons.js",
      "types": "./dist/icons.d.ts"
    },
    "./package.json": "./package.json",
    "./styles/global.css": "./src/styles/global.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./tailwind/products": "./src/tailwind/products.css",
    "./tailwind/tokens": "./src/tailwind/tokens.css",
    "./svg/*.svg": "./src/svg/*.svg"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/FerrLabs/UI#readme",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "name": "@ferrlabs/ui-foundation",
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "directory": "packages/foundation",
    "type": "git",
    "url": "git+https://github.com/FerrLabs/UI.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "3.1.0"
}

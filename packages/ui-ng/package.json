{
  "name": "@ferrlabs/ui-ng",
  "version": "1.44.0",
  "description": "FerrLabs design system: Angular 22 components (standalone, signals, zoneless), themed by the tokens of @ferrlabs/ui-foundation.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/FerrLabs/UI#readme",
  "repository": {
    "directory": "packages/ui-ng",
    "type": "git",
    "url": "git+https://github.com/FerrLabs/UI.git"
  },
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/ferrlabs-ui-ng.d.ts",
      "default": "./dist/fesm2022/ferrlabs-ui-ng.mjs"
    },
    "./docs": {
      "types": "./dist/types/ferrlabs-ui-ng-docs.d.ts",
      "default": "./dist/fesm2022/ferrlabs-ui-ng-docs.mjs"
    },
    "./docs/styles.css": {
      "default": "./docs/styles.css"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "watch": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit --inlineSources false --declarationMap false"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@ferrlabs/ui-foundation": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ferrlabs/ui-foundation": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@ferrlabs/ui-foundation": "workspace:^",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

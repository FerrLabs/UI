{
  "name": "@ferrlabs/ui-ng",
  "version": "1.24.1",
  "description": "FerrLabs design system — Angular 22 components (standalone, signals, zoneless). Mirrors @ferrlabs/ui-react; consumes tokens from @ferrlabs/ui-foundation.",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": false,
  "exports": {
    "./docs/styles.css": {
      "default": "./docs/styles.css"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "watch": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit --inlineSources false --declarationMap false"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0"
  },
  "peerDependenciesMeta": {
    "@ferrlabs/ui-foundation": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}

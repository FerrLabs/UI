{
  "name": "@ferrlabs/ui-auth",
  "version": "0.1.0",
  "description": "React auth forms shared across FerrLabs product apps — login, signup, reset password, OAuth buttons, 2FA.",
  "type": "module",
  "files": ["src", "dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@ferrlabs/ui-react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

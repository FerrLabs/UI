---
/**
 * EN/FR language switcher used in every FerrLabs site navbar.
 *
 * Self-contained: scoped styles and an inline client script ship with
 * the component. Consuming sites just drop it in and get everything —
 * the globe icon, the native <select>, the caret, the navigation on
 * change, and the optional locale-preference save hook.
 *
 * Styling mirrors Starlight's LanguageSelect (same icon geometry, same
 * padding math) so the marketing navbar picker and the docs navbar
 * picker stay visually identical.
 *
 * The script is idempotent (guarded by a window flag) and queries by
 * the `data-ferrlabs-lang-switcher` attribute, so multiple instances on
 * a single page cannot collide on DOM ids. Only one instance per page
 * is expected in practice, but the component does not rely on it.
 *
 * If the consuming site defines a global `window.__saveLang(lang)` hook,
 * it is called before navigation so the locale preference persists for
 * future first visits. Absent that hook, the switcher still works.
 */
interface Props {
  lang: 'en' | 'fr';
  /** URL for the EN version of the current page. */
  enEquiv: string;
  /** URL for the FR version of the current page. */
  frEquiv: string;
  /** When false, the FR option is rendered disabled with a "(soon)" hint. Default: true. */
  hasAltTranslation?: boolean;
}

const { lang, enEquiv, frEquiv, hasAltTranslation = true } = Astro.props;
---

<label class="ferrlabs-lang-select" style="--sl-select-width: 7em;">
  <span class="sr-only">Language</span>
  <svg class="ferrlabs-lang-select-icon ferrlabs-lang-select-label-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="M8.516 3a.94.94 0 0 0-.941.94v1.15H2.94a.94.94 0 1 0 0 1.882h7.362a7.422 7.422 0 0 1-1.787 3.958 7.42 7.42 0 0 1-1.422-2.425.94.94 0 1 0-1.774.627 9.303 9.303 0 0 0 1.785 3.043 7.422 7.422 0 0 1-4.164 1.278.94.94 0 1 0 0 1.881 9.303 9.303 0 0 0 5.575-1.855 9.303 9.303 0 0 0 4.11 1.74l-.763 1.525a.968.968 0 0 0-.016.034l-1.385 2.77a.94.94 0 1 0 1.683.841l1.133-2.267h5.806l1.134 2.267a.94.94 0 0 0 1.683-.841l-1.385-2.769a.95.95 0 0 0-.018-.036l-3.476-6.951a.94.94 0 0 0-1.682 0l-1.82 3.639a7.423 7.423 0 0 1-3.593-1.256 9.303 9.303 0 0 0 2.27-5.203h1.894a.94.94 0 0 0 0-1.881H9.456V3.94A.94.94 0 0 0 8.516 3Zm6.426 11.794a1.068 1.068 0 0 1-.02.039l-.703 1.407h3.924l-1.962-3.924-1.24 2.478Z" clip-rule="evenodd"/>
  </svg>
  <select data-ferrlabs-lang-switcher autocomplete="off">
    <option value={enEquiv} selected={lang === 'en'}>English</option>
    <option value={frEquiv} selected={lang === 'fr'} disabled={!hasAltTranslation}>
      {hasAltTranslation ? 'Français' : 'Français (soon)'}
    </option>
  </select>
  <svg class="ferrlabs-lang-select-icon ferrlabs-lang-select-caret" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"/>
  </svg>
</label>

<script is:inline>
  (function () {
    if (window.__ferrlabsLangSwitcherWired) return;
    window.__ferrlabsLangSwitcherWired = true;
    document.querySelectorAll('select[data-ferrlabs-lang-switcher]').forEach(function (el) {
      el.addEventListener('change', function () {
        var target = el.value;
        if (!target || target === window.location.pathname) return;
        var inferredLang = target.indexOf('/fr') === 0 ? 'fr' : 'en';
        var saveLang = window.__saveLang;
        if (typeof saveLang === 'function') saveLang(inferredLang);
        window.location.assign(target);
      });
    });
  })();
</script>

<style>
  /* Mirrors Starlight's Select component geometry (same sizing vars,
     same absolute positioning, same padding math) so marketing and docs
     pickers stay visually identical. Color is inherited from the parent
     navbar — set `color` on the surrounding container. */
  .ferrlabs-lang-select {
    --sl-label-icon-size: 0.875rem;
    --sl-caret-size: 1.25rem;
    --sl-inline-padding: 0.5rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .ferrlabs-lang-select-icon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .ferrlabs-lang-select-label-icon {
    width: var(--sl-label-icon-size);
    height: var(--sl-label-icon-size);
    inset-inline-start: 0;
  }
  .ferrlabs-lang-select-caret {
    width: var(--sl-caret-size);
    height: var(--sl-caret-size);
    inset-inline-end: 0;
  }

  .ferrlabs-lang-select select {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    margin: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-overflow: ellipsis;
    padding-block: 0.375rem;
    padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
                     calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
    margin-inline: calc(var(--sl-inline-padding) * -1);
    width: calc(var(--sl-select-width, 7em) + var(--sl-inline-padding) * 2);
  }
  .ferrlabs-lang-select select:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Screen-reader-only utility. Self-contained so consuming sites don't
     have to ship their own .sr-only rule. */
  .ferrlabs-lang-select .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

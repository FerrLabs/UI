---
import LanguageSelect from './LanguageSelect.astro';

type LegacyAccent = 'slate' | 'orange' | 'emerald' | 'indigo' | 'violet' | 'amber';
type Product = 'ferrlabs' | 'ferrflow' | 'ferrvault' | 'ferrtrack' | 'ferrgrowth' | 'ferrfleet';
type Lang = 'en' | 'fr';

export interface Link {
  label: string;
  href: string;
  external?: boolean;
}

export interface Brand {
  name: string;
  href: string;
  logoSrc?: string;
}

interface Props {
  lang: Lang;
  accent: LegacyAccent | string;
  accentSlug?: LegacyAccent;
  currentProduct?: Product;
  brand?: Brand;
  brandName?: string;
  brandTag?: string;
  brandHref?: string;
  navLinks?: Link[];
  links?: Link[];
  cta?: { label: string; href: string; external?: boolean };
  gitHubUrl?: string;
  activePage?: 'home' | 'docs' | string;
  enEquiv?: string;
  frEquiv?: string;
  hasAltTranslation?: boolean;
  hideLanguageToggle?: boolean;
  sticky?: boolean;
  translucent?: boolean;
}

const {
  lang,
  accent,
  accentSlug,
  currentProduct,
  brand,
  brandName,
  brandTag,
  brandHref,
  navLinks,
  links = [],
  cta,
  gitHubUrl,
  activePage,
  enEquiv = '/',
  frEquiv = '/fr/',
  hasAltTranslation = true,
  hideLanguageToggle = false,
  sticky = true,
  translucent = true,
} = Astro.props;

const isHexAccent = typeof accent === 'string' && accent.startsWith('#');
const legacyAccentName: LegacyAccent | undefined =
  accentSlug ?? (isHexAccent ? undefined : (accent as LegacyAccent));
const isEditorialMode = Boolean(brandName) || isHexAccent;

const resolvedLinks: Link[] = navLinks ?? links;
const resolvedBrandName = brandName ?? brand?.name ?? 'FerrLabs';
const resolvedBrandHref = brandHref ?? brand?.href ?? (lang === 'fr' ? '/fr/' : '/');
const resolvedLogoSrc = brand?.logoSrc;

function isLinkActive(href: string): boolean {
  if (!activePage) return false;
  if (activePage === 'docs' && href.includes('/docs')) return true;
  if (activePage !== 'home' && href.includes(`/${activePage}`)) return true;
  return false;
}
const isBrandActive = activePage === 'home';

const legacySlug = (a: LegacyAccent | undefined) =>
  !a ? 'flow-orange' :
  a === 'slate' ? 'labs-slate' :
  a === 'orange' ? 'flow-orange' :
  a === 'emerald' ? 'vault-emerald' :
  a === 'indigo' ? 'track-indigo' :
  a === 'amber' ? 'fleet-amber' : 'growth-violet';

const accentCssValue = isHexAccent ? (accent as string) : `var(--color-ferr${legacySlug(legacyAccentName)})`;

const t = (en: string, fr: string) => (lang === 'fr' ? fr : en);

const allProducts: { id: Product; label: string; href: string; accent: LegacyAccent; tagline: string; taglineFr: string }[] = [
  { id: 'ferrlabs',   label: 'FerrLabs',   href: 'https://ferrlabs.com',   accent: 'slate',
    tagline: 'Developer tools company',          taglineFr: 'Éditeur d’outils pour développeurs' },
  { id: 'ferrgrowth', label: 'FerrGrowth', href: 'https://ferrgrowth.com', accent: 'violet',
    tagline: 'Growth tooling',                   taglineFr: 'Outils de croissance' },
  { id: 'ferrfleet',  label: 'FerrFleet',  href: 'https://ferrfleet.com',  accent: 'amber',
    tagline: 'Agent fleet runtime',              taglineFr: 'Runtime de flotte d\'agents' },
  { id: 'ferrtrack',  label: 'FerrTrack',  href: 'https://ferrtrack.com',  accent: 'indigo',
    tagline: 'Issue tracker',                    taglineFr: 'Suivi d’issues' },
  { id: 'ferrvault',  label: 'FerrVault',  href: 'https://ferrvault.com',  accent: 'emerald',
    tagline: 'Secrets management',               taglineFr: 'Gestion des secrets' },
  { id: 'ferrflow',   label: 'FerrFlow',   href: 'https://ferrflow.com',   accent: 'orange',
    tagline: 'Versioning CLI (open source)',     taglineFr: 'CLI de versioning (open source)' },
];

const initial = resolvedBrandName.replace(/[^A-Za-z]/g, '').charAt(0).toUpperCase() || 'F';
const hasLogoSlot = Astro.slots.has('logo');
---

{isEditorialMode ? (
  <>
    <header id="ferrlabs-edi-nav" class="ferrlabs-edi-nav" style={`--ferr-accent: ${accentCssValue};`}>
      <div class="edi-nav-container">
        <a href={resolvedBrandHref} class="edi-brand" aria-label={resolvedBrandName}>
          {hasLogoSlot ? (
            <slot name="logo" />
          ) : resolvedLogoSrc ? (
            <img src={resolvedLogoSrc} alt="" class="edi-brand-img" />
          ) : (
            <span class="edi-brand-fallback" aria-hidden="true">{initial}</span>
          )}
          <span class="edi-brand-name">{resolvedBrandName}</span>
          {brandTag && <span class="mono edi-brand-tag">{brandTag}</span>}
        </a>

        <nav class="edi-desktop-nav" aria-label="Primary">
          {resolvedLinks.map((l) => (
            <a
              href={l.href}
              class="edi-nav-link mono"
              rel={l.external ? 'noopener noreferrer' : undefined}
              target={l.external ? '_blank' : undefined}
            >
              {l.label}
            </a>
          ))}

          {!hideLanguageToggle && (
            <div class="edi-lang-pill mono">
              <a href={enEquiv} class:list={['edi-lang-opt', lang === 'en' && 'active']}>EN</a>
              <a href={frEquiv} class:list={['edi-lang-opt', lang === 'fr' && 'active', !hasAltTranslation && 'is-disabled']} aria-disabled={!hasAltTranslation || undefined}>FR</a>
            </div>
          )}

          {gitHubUrl && (
            <a href={gitHubUrl} class="edi-github" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
              </svg>
            </a>
          )}

          {cta && (
            <a
              href={cta.href}
              class="edi-cta mono"
              rel={cta.external ? 'noopener noreferrer' : undefined}
              target={cta.external ? '_blank' : undefined}
            >
              {cta.label}
              <span aria-hidden>→</span>
            </a>
          )}
        </nav>

        <button class="edi-mobile-toggle mono" id="ferrlabs-edi-mobile-toggle" type="button" aria-label={t('Open menu', 'Ouvrir le menu')}>
          {t('Menu', 'Menu')}
        </button>
      </div>
    </header>

    <div id="ferrlabs-edi-mobile-menu" class="edi-mobile-menu" aria-hidden="true">
      <div class="edi-mobile-menu-top edi-nav-container">
        <a href={resolvedBrandHref} class="edi-brand">
          {hasLogoSlot ? <slot name="logo" /> : (
            <span class="edi-brand-fallback" aria-hidden="true">{initial}</span>
          )}
          <span class="edi-brand-name">{resolvedBrandName}</span>
        </a>
        <button class="edi-mobile-close mono" id="ferrlabs-edi-mobile-close" type="button" aria-label={t('Close', 'Fermer')}>
          {t('Close', 'Fermer')}
        </button>
      </div>
      <div class="edi-mobile-links edi-nav-container">
        {resolvedLinks.map((l, i) => (
          <a href={l.href} class="edi-mobile-link">
            <span class="mono edi-mobile-link-num">0{i + 1}</span>
            {l.label}
          </a>
        ))}
        {cta && (
          <a href={cta.href} class="edi-mobile-cta mono">
            {cta.label}
            <span aria-hidden>→</span>
          </a>
        )}
        {!hideLanguageToggle && (
          <div class="edi-mobile-lang mono">
            <a href={enEquiv} class:list={['edi-lang-opt', lang === 'en' && 'active']}>EN</a>
            <a href={frEquiv} class:list={['edi-lang-opt', lang === 'fr' && 'active', !hasAltTranslation && 'is-disabled']}>FR</a>
          </div>
        )}
      </div>
    </div>

    <script is:inline>
      (function () {
        if (window.__ferrlabsEdiNavWired) return;
        window.__ferrlabsEdiNavWired = true;
        var navbar = document.getElementById('ferrlabs-edi-nav');
        var onScroll = function () {
          if (!navbar) return;
          if (window.scrollY > 8) navbar.classList.add('scrolled');
          else navbar.classList.remove('scrolled');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        document.querySelectorAll('.edi-lang-opt').forEach(function (a) {
          a.addEventListener('click', function () {
            try { localStorage.setItem('lang-pref', (a.textContent || '').trim().toLowerCase()); } catch (e) {}
          });
        });

        var menu = document.getElementById('ferrlabs-edi-mobile-menu');
        var toggle = document.getElementById('ferrlabs-edi-mobile-toggle');
        var close = document.getElementById('ferrlabs-edi-mobile-close');
        if (menu && toggle && close) {
          var open = function () { menu.classList.add('open'); menu.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; };
          var shut = function () { menu.classList.remove('open'); menu.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; };
          toggle.addEventListener('click', open);
          close.addEventListener('click', shut);
          menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', shut); });
        }
      })();
    </script>

    <style is:global>
      .ferrlabs-edi-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background 200ms ease, border-color 200ms ease, backdrop-filter 200ms ease;
      }
      .ferrlabs-edi-nav.scrolled {
        background: color-mix(in oklab, var(--bg, #faf8f4) 78%, transparent);
        -webkit-backdrop-filter: saturate(140%) blur(14px);
        backdrop-filter: saturate(140%) blur(14px);
        border-bottom-color: var(--rule, rgba(30, 41, 59, 0.14));
      }
      .edi-nav-container {
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 40px;
        display: flex;
        align-items: center;
        height: 72px;
        gap: 24px;
      }
      @media (max-width: 768px) { .edi-nav-container { padding: 0 20px; } }

      .edi-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--fg, #1e293b);
        text-decoration: none;
      }
      .edi-brand-img { height: 28px; width: auto; }
      .edi-brand-fallback {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 0.5rem;
        background: var(--ferr-accent);
        color: #fff;
        font-weight: 700;
        font-size: 0.875rem;
      }
      .edi-brand-name {
        font-family: var(--font-serif, 'Fraunces', Georgia, ui-serif, serif);
        font-weight: 900;
        font-size: 22px;
        letter-spacing: -0.02em;
      }
      .edi-brand-tag {
        font-size: 11px;
        color: var(--fg-3, #64748b);
        letter-spacing: 0.05em;
        margin-left: 4px;
        margin-top: 4px;
      }
      .mono { font-family: var(--font-mono, 'DM Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); }

      .edi-desktop-nav {
        display: flex;
        align-items: center;
        gap: 28px;
        margin-left: auto;
      }

      .edi-nav-link {
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--fg-2, #475569);
        text-decoration: none;
        position: relative;
        padding: 6px 0;
      }
      .edi-nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 1px;
        background: var(--fg, #1e293b);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 220ms ease;
      }
      .edi-nav-link:hover::after { transform: scaleX(1); }

      .edi-lang-pill {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--rule, rgba(30, 41, 59, 0.14));
        border-radius: 999px;
        overflow: hidden;
      }
      .edi-lang-opt {
        padding: 6px 12px;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fg-2, #475569);
        background: transparent;
        text-decoration: none;
        transition: background 180ms, color 180ms;
      }
      .edi-lang-opt.active {
        background: var(--fg, #1e293b);
        color: var(--bg, #faf8f4);
      }
      .edi-lang-opt.is-disabled {
        opacity: 0.4;
        text-decoration: line-through;
        cursor: not-allowed;
      }

      .edi-github {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--fg-2, #475569);
        transition: color 180ms ease;
      }
      .edi-github:hover { color: var(--fg, #1e293b); }

      .edi-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--ferr-accent);
        color: #fff;
        text-decoration: none;
        transition: opacity 180ms, transform 180ms;
      }
      .edi-cta:hover { opacity: 0.92; transform: translateY(-1px); }

      .edi-mobile-toggle {
        display: none;
        margin-left: auto;
        border: 1px solid var(--rule, rgba(30, 41, 59, 0.14));
        border-radius: 999px;
        background: transparent;
        color: var(--fg, #1e293b);
        padding: 8px 14px;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .edi-mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: var(--bg, #faf8f4);
        display: none;
      }
      .edi-mobile-menu.open { display: block; }
      .edi-mobile-menu-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }
      .edi-mobile-close {
        border: 1px solid var(--rule, rgba(30, 41, 59, 0.14));
        border-radius: 999px;
        background: transparent;
        color: var(--fg, #1e293b);
        padding: 8px 14px;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .edi-mobile-links {
        padding-top: 40px;
        padding-bottom: 40px;
        display: flex;
        flex-direction: column;
      }
      .edi-mobile-link {
        font-family: var(--font-serif, 'Fraunces', Georgia, ui-serif, serif);
        font-weight: 700;
        font-size: clamp(40px, 9vw, 72px);
        letter-spacing: -0.03em;
        line-height: 1.04;
        border-bottom: 1px solid var(--rule, rgba(30, 41, 59, 0.14));
        padding: 20px 0;
        display: flex;
        align-items: baseline;
        gap: 16px;
        color: var(--fg, #1e293b);
        text-decoration: none;
      }
      .edi-mobile-link-num {
        font-size: 12px;
        color: var(--fg-3, #64748b);
        font-weight: 400;
        letter-spacing: 0.1em;
      }
      .edi-mobile-cta {
        margin-top: 40px;
        align-self: flex-start;
        background: var(--ferr-accent);
        color: #fff;
        padding: 16px 24px;
        border-radius: 999px;
        font-size: 13px;
        letter-spacing: 0.04em;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .edi-mobile-lang {
        margin-top: 24px;
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--rule, rgba(30, 41, 59, 0.14));
        border-radius: 999px;
        overflow: hidden;
        align-self: flex-start;
      }

      @media (max-width: 880px) {
        .edi-desktop-nav { display: none; }
        .edi-mobile-toggle { display: inline-flex; }
      }
    </style>
  </>
) : (
  <>
    <header
      class:list={['ferrlabs-nav', { sticky, translucent }]}
      style={`--accent: ${accentCssValue};`}
      data-current-product={currentProduct}
    >
      <div class="ferrlabs-nav-inner">
        <a
          href={resolvedBrandHref}
          class:list={['ferrlabs-nav-brand', { current: isBrandActive }]}
          aria-label={resolvedBrandName}
          aria-current={isBrandActive ? 'page' : undefined}
        >
          {resolvedLogoSrc ? (
            <img src={resolvedLogoSrc} alt="" class="ferrlabs-nav-logo" />
          ) : (
            <span class="ferrlabs-nav-logo-fallback" aria-hidden="true">{initial}</span>
          )}
          <span class="ferrlabs-nav-brand-name">{resolvedBrandName}</span>
        </a>

        <nav class="ferrlabs-nav-links" aria-label="Primary">
          {resolvedLinks.map((link) => (
            <a
              href={link.href}
              rel={link.external ? 'noopener noreferrer' : undefined}
              target={link.external ? '_blank' : undefined}
              class:list={{ current: isLinkActive(link.href) }}
              aria-current={isLinkActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}

          <div class="ferrlabs-nav-products" data-ferrlabs-nav-products>
            <button
              type="button"
              class="ferrlabs-nav-products-trigger"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="ferrlabs-nav-products-menu"
            >
              {t('Products', 'Produits')}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <div id="ferrlabs-nav-products-menu" class="ferrlabs-nav-products-menu" role="menu" hidden>
              <ul>
                {allProducts.map((p) => (
                  <li role="none">
                    <a
                      href={p.href}
                      role="menuitem"
                      class:list={['ferrlabs-nav-product', { current: p.id === currentProduct }]}
                      aria-current={p.id === currentProduct ? 'page' : undefined}
                    >
                      <span
                        class="ferrlabs-nav-product-swatch"
                        style={`--swatch: var(--color-ferr${legacySlug(p.accent)});`}
                        aria-hidden="true"
                      ></span>
                      <span class="ferrlabs-nav-product-text">
                        <strong>{p.label}</strong>
                        <em>{lang === 'fr' ? p.taglineFr : p.tagline}</em>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </nav>

        <div class="ferrlabs-nav-center">
          <slot name="center" />
        </div>

        <div class="ferrlabs-nav-trailing">
          <slot />
          {!hideLanguageToggle && (
            <LanguageSelect
              lang={lang}
              enEquiv={enEquiv}
              frEquiv={frEquiv}
              hasAltTranslation={hasAltTranslation}
            />
          )}
          {cta && (
            <a
              href={cta.href}
              class="ferrlabs-nav-cta"
              rel={cta.external ? 'noopener noreferrer' : undefined}
              target={cta.external ? '_blank' : undefined}
            >
              {cta.label}
            </a>
          )}
        </div>
      </div>
    </header>

    <script is:inline>
      (function () {
        if (window.__ferrlabsNavProductsWired) return;
        window.__ferrlabsNavProductsWired = true;

        document.querySelectorAll('[data-ferrlabs-nav-products]').forEach(function (root) {
          var trigger = root.querySelector('.ferrlabs-nav-products-trigger');
          var menu = root.querySelector('.ferrlabs-nav-products-menu');
          if (!trigger || !menu) return;

          var open = function () {
            menu.hidden = false;
            trigger.setAttribute('aria-expanded', 'true');
          };
          var close = function () {
            menu.hidden = true;
            trigger.setAttribute('aria-expanded', 'false');
          };
          var toggle = function () {
            if (menu.hidden) open(); else close();
          };

          trigger.addEventListener('click', function (e) {
            e.stopPropagation();
            toggle();
          });

          document.addEventListener('click', function (e) {
            if (!root.contains(e.target)) close();
          });

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !menu.hidden) {
              close();
              trigger.focus();
            }
          });
        });

        if (!window.__ferrlabsNavScrollWired) {
          window.__ferrlabsNavScrollWired = true;
          var legacyNavs = document.querySelectorAll('.ferrlabs-nav.sticky');
          if (legacyNavs.length) {
            var sync = function () {
              var scrolled = window.scrollY > 8;
              legacyNavs.forEach(function (n) { n.classList.toggle('scrolled', scrolled); });
            };
            sync();
            window.addEventListener('scroll', sync, { passive: true });
          }
        }
      })();
    </script>

    <style is:global>
      .ferrlabs-nav {
        --nav-fg: #0f172a;
        --nav-bg: #ffffff;
        --nav-muted: #475569;
        --nav-border: rgba(15, 23, 42, 0.08);
        background: var(--nav-bg);
        border-bottom: 1px solid transparent;
        color: var(--nav-fg);
        z-index: 40;
        transition: border-color 200ms ease;
      }
      .ferrlabs-nav.sticky {
        position: sticky;
        top: 0;
      }
      .ferrlabs-nav.translucent {
        background: color-mix(in srgb, var(--nav-bg) 85%, transparent);
        backdrop-filter: saturate(180%) blur(10px);
        -webkit-backdrop-filter: saturate(180%) blur(10px);
      }
      .ferrlabs-nav.scrolled {
        border-bottom-color: var(--nav-border);
      }

      .ferrlabs-nav-inner {
        position: relative;
        max-width: 80rem;
        margin: 0 auto;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .ferrlabs-nav-center {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        pointer-events: none;
      }
      .ferrlabs-nav-center > * {
        pointer-events: auto;
      }
      @media (max-width: 900px) {
        .ferrlabs-nav-center {
          position: static;
          transform: none;
        }
      }

      .ferrlabs-nav-brand {
        display: inline-flex;

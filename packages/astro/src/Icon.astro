---
import { icons, type IconName } from '@ferrlabs/ui-foundation/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  title?: string;
}
const { name, size = 16, class: className, title } = Astro.props;
const raw = icons[name].replace(
  /<svg /,
  `<svg width="${size}" height="${size}" style="display:block" `,
);
const label = title ?? '';
---

<span
  class:list={['ferrlabs-icon', className]}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label || undefined}
  role={label ? 'img' : undefined}
  style={`--ferrlabs-icon-size:${size}px;`}
  set:html={raw}
/>

<style>
  .ferrlabs-icon {
    display: inline-grid;
    place-items: center;
    width: var(--ferrlabs-icon-size);
    height: var(--ferrlabs-icon-size);
    flex-shrink: 0;
    line-height: 0;
    color: currentColor;
  }
</style>

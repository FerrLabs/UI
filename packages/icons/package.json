{
  "name": "@ferrlabs/ui-icons",
  "version": "0.1.0",
  "description": "SVG icon set shared across FerrLabs products.",
  "type": "module",
  "files": ["src", "dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svg/*": "./src/svg/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FerrLabs/UI.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/FerrLabs/UI/issues"
  },
  "homepage": "https://github.com/FerrLabs/UI#readme",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}

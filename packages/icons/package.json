{
  "bugs": {
    "url": "https://github.com/FerrLabs/UI/issues"
  },
  "description": "SVG icon set shared across FerrLabs products.",
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./svg/*": "./src/svg/*"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/FerrLabs/UI#readme",
  "main": "./dist/index.js",
  "name": "@ferrlabs/ui-icons",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "directory": "packages/icons",
    "type": "git",
    "url": "git+https://github.com/FerrLabs/UI.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.0"
}

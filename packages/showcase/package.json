{
  "name": "@ferrlabs/ui-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook showcase for @ferrlabs/ui-ng. Brand selector across FerrLabs / FerrFlow / FerrVault / FerrTrack / FerrGrowth / FerrFleet / FerrLens, with a light/dark toggle.",
  "type": "module",
  "scripts": {
    "styles": "node scripts/fonts.mjs && tailwindcss -i .storybook/preview.src.css -o .storybook/preview.css",
    "storybook": "pnpm styles && ng run showcase:storybook",
    "build": "pnpm styles && ng run showcase:build-storybook",
    "typecheck": "tsc --noEmit",
    "test": "test-storybook",
    "test:ci": "test-storybook --maxWorkers=2"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@ferrlabs/ui-foundation": "workspace:*",
    "@ferrlabs/ui-ng": "workspace:*",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/angular": "^10.0.0",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/cli": "^4.1.13",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.5",
    "http-server": "^14.1.1",
    "playwright": "^1.62.1",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.0",
    "wait-on": "^9.1.0"
  }
}
